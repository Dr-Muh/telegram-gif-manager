BOT_TOKEN=replace-with-botfather-token
# Comma-separated Telegram user IDs of bot admins. Admins can always use the bot
# and manage other users with /allow, /revoke, and /users.
ADMIN_USER_IDS=123456789
# Local runs store data in ./data. Docker overrides this with /data.
DATA_DIR=./data
# 20 MiB, the largest file the hosted Bot API lets bots download
MAX_FILE_SIZE=20971520
